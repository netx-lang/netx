component CAVLC : 
  [total_coeffs, ctable, trailing_ones] -> 
  [coeff_token, ctoken_len] {
  wire total_coeffs  of bit(5);
  wire ctable        of bit(3);
  wire trailing_ones of bit(2);

  wire coeff_token   of bit(6);
  wire ctoken_len    of bit(5);

  let VLC0 = [
    [ 1'b1,                 1'b0,                 1'b0,                 1'b0               ],
    [ 6'b000101,            2'b01,                1'b0,                 1'b0               ],
    [ 8'b00000111,          6'b000100,            3'b001,               1'b0               ],
    [ 9'b000000111,         8'b00000110,          7'b0000101,           5'b00011           ],
    [10'b0000000111,        9'b000000110,         8'b00000101,          6'b000011          ],
    [11'b00000000111,      10'b0000000110,        9'b000000101,         7'b0000100         ],
    [13'b0000000001111,    11'b00000000110,      10'b0000000101,        8'b00000100        ],
    [13'b0000000001011,    13'b0000000001110,    11'b00000000101,       9'b000000100       ],
    [13'b0000000001000,    13'b0000000001010,    13'b0000000001101,    10'b0000000100      ],
    [14'b00000000001111,   14'b00000000001110,   13'b0000000001001,    11'b00000000100     ],
    [14'b00000000001011,   14'b00000000001010,   14'b00000000001101,   13'b0000000001100   ],
    [15'b000000000001111,  15'b000000000001110,  14'b00000000001001,   14'b00000000001100  ],
    [15'b000000000001011,  15'b000000000001010,  15'b000000000001101,  14'b00000000001000  ],
    [16'b0000000000001111, 15'b000000000000001,  15'b000000000001001,  15'b000000000001100 ],
    [16'b0000000000001011, 16'b0000000000001110, 16'b0000000000001101, 15'b000000000001000 ],
    [16'b0000000000000111, 16'b0000000000001010, 16'b0000000000001001, 16'b0000000000001100],
    [16'b0000000000000100, 16'b0000000000000110, 16'b0000000000000101, 16'b0000000000001000]
  ];
  let VLC0_L = [
    [ 1,  1,  1,  1],
    [ 6,  2,  1,  1],
    [ 8,  6,  3,  1],
    [ 9,  8,  7,  5],
    [10,  9,  8,  6],
    [11, 10,  9,  7],
    [13, 11, 10,  8],
    [13, 13, 11,  9],
    [13, 13, 13, 10],
    [14, 14, 13, 11],
    [14, 14, 14, 13],
    [15, 15, 14, 14],
    [15, 15, 15, 14],
    [16, 15, 15, 15],
    [16, 16, 16, 15],
    [16, 16, 16, 16],
    [16, 16, 16, 16]
  ];
  let VLC1 = [
    [ 2'b11,              1'b0,               1'b0,               1'b0             ],
    [ 6'b001011,          2'b10,              1'b0,               1'b0             ],
    [ 6'b000111,          5'b00111,           3'b011,             1'b0             ],
    [ 7'b0000111,         6'b001010,          6'b001001,          4'b0101          ],
    [ 8'b00000111,        6'b000110,          6'b000101,          4'b0100          ],
    [ 8'b00000100,        7'b0000110,         7'b0000101,         5'b00110         ],
    [ 9'b000000111,       8'b00000110,        8'b00000101,        6'b001000        ],
    [11'b00000001111,     9'b000000110,       9'b000000101,       6'b000100        ],
    [11'b00000001011,    11'b00000001110,    11'b00000001101,     7'b0000100       ],
    [12'b000000001111,   11'b00000001010,    11'b00000001001,     9'b000000100     ],
    [12'b000000001011,   12'b000000001110,   12'b000000001101,   11'b00000001100   ],
    [12'b000000001000,   12'b000000001010,   12'b000000001001,   11'b00000001000   ],
    [13'b0000000001111,  13'b0000000001110,  13'b0000000001101,  12'b000000001100  ],
    [13'b0000000001011,  13'b0000000001010,  13'b0000000001001,  13'b0000000001100 ],
    [13'b0000000000111,  14'b00000000001011, 13'b0000000000110,  13'b0000000001000 ],
    [14'b00000000001001, 14'b00000000001000, 14'b00000000001010, 13'b0000000000001 ],
    [14'b00000000000111, 14'b00000000000110, 14'b00000000000101, 14'b00000000000100]
  ];
  let VLC1_L = [
    [ 2,  1,  1,  1],
    [ 6,  2,  1,  1],
    [ 6,  5,  3,  1],
    [ 7,  6,  6,  4],
    [ 8,  6,  6,  4],
    [ 8,  7,  7,  5],
    [ 9,  8,  8,  6],
    [11,  9,  9,  6],
    [11, 11, 11,  7],
    [12, 11, 11,  9],
    [12, 12, 12, 11],
    [12, 12, 12, 11],
    [13, 13, 13, 12],
    [13, 13, 13, 13],
    [13, 14, 13, 13],
    [14, 14, 14, 13],
    [14, 14, 14, 14]
  ];
  let VLC2 = [
    [ 4'b1111,          1'b0,             1'b0,            1'b0],
    [ 6'b001111,        4'b1110,          1'b0,            1'b0],
    [ 6'b001011,        5'b01111,         4'b1101,         1'b0],
    [ 6'b001000,        5'b01100,         5'b01110,        4'b1100],
    [ 7'b0001111,       5'b01010,         5'b01011,        4'b1011],
    [ 7'b0001011,       5'b01000,         5'b01001,        4'b1010],
    [ 7'b0001001,       6'b001110,        6'b001101,       4'b1001],
    [ 7'b0001000,       6'b001010,        6'b001001,       4'b1000],
    [ 8'b00001111,      7'b0001110,       7'b0001101,      5'b01101],
    [ 8'b00001011,      8'b00001110,      7'b0001010,      6'b001100],
    [ 9'b000001111,     8'b00001010,      8'b00001101,     7'b0001100],
    [ 9'b000001011,     9'b000001110,     8'b00001001,     8'b00001100],
    [ 9'b000001000,     9'b000001010,     9'b000001101,    8'b00001000],
    [10'b0000001101,    9'b000000111,     9'b000001001,    9'b000001100],
    [10'b0000001001,   10'b0000001100,   10'b0000001011,  10'b0000001010],
    [10'b0000000101,   10'b0000001000,   10'b0000000111,  10'b0000000110],
    [10'b0000000001,   10'b0000000100,   10'b0000000011,  10'b0000000010]
  ];
  let VLC2_L = [
    [ 4,  1,  1,  1],
    [ 6,  4,  1,  1],
    [ 6,  5,  4,  1],
    [ 6,  5,  5,  4],
    [ 7,  5,  5,  4],
    [ 7,  5,  5,  4],
    [ 7,  6,  6,  4],
    [ 7,  6,  6,  4],
    [ 8,  7,  7,  5],
    [ 8,  8,  7,  6],
    [ 9,  8,  8,  7],
    [ 9,  9,  8,  8],
    [ 9,  9,  9,  8],
    [10,  9,  9,  9],
    [10, 10, 10, 10],
    [10, 10, 10, 10],
    [10, 10, 10, 10]
  ];

  let gen_mux_from(table, width) =
    let gen_row(i) = 
      MUX(2) <> [trailing_ones] ++ [CAST(width) <> table[i][j] | j in [0..4]]
    in
      MUX(1) <> {
        sel : total_coeffs[4],
        case[1] : gen_row(16),
        case[0] : MUX(4) <> 
          [total_coeffs[3:0]] ++ 
          [gen_row(i) | i in [0..16]]
      };

  coeff_token <> MUX(1) <> {
    sel : ctable[2],
    case[0] : 
      MUX(1) <> {
        sel : ctable[1],
        case[0] : gen_mux_from(VLC0, 6), // 0 <= nC < 2        
        case[1] : gen_mux_from(VLC1, 6)  // 2 <= nC < 4
      },
    case[1] : gen_mux_from(VLC2, 6)      // 4 <= nC < 8
  };

  ctoken_len <> MUX(1) <> {
    sel : ctable[2],
    case[0] : 
      MUX(1) <> {
        sel : ctable[1],
        case[0] : gen_mux_from(VLC0_L, 5), // 0 <= nC < 2        
        case[1] : gen_mux_from(VLC1_L, 5)  // 2 <= nC < 4
      },
    case[1] : gen_mux_from(VLC2_L, 5)      // 4 <= nC < 8
  };
}

component MUX(width) : [sel] ++ [case[i] | i in [0..W]] -> [output] {
  let W = 2**width;
  wire sel  of bit(width);
  wire mask of bit(W);
  auto case[W], output;

  mask <> DECODER(width) <> sel;
  output <> OR(W) <> [
    AND <> [case[i], CAST <> mask[i]] | i in [0..W]
  ];
}

component DECODER(width) : [input] -> [output] {
  let W = 2**width;
  wire input  of bit(width);
  wire output of bit(W);
  
  for i in [0..W] {
    output[i] <> AND(width) <> [port |
      j in [0..width],
      let port = if (i >> j) & 1 then TO else NOT
    ] <> [input[j] | j in [0..width]];
  }
}


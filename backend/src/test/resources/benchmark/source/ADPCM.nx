// compute vpdiff = (delta + 0.5) * step / 4
component ADPCM : [step, delta] -> [vpdiff] {
    wire step   of bit(16);
    wire delta  of bit(4);

    wire vpdiff of bit(16);
    
    let if_then_add(cond, adder, base) = 
        MUX <> [cond, ADD <> [base, adder], base ];

    vpdiff <> if_then_add (
        delta[2],
        step,
        if_then_add (
            delta[1],
            LSHR <> [step, 1],
            if_then_add (
                delta[0],
                LSHR <> [step, 2],
                LSHR <> [step, 3]
            )
        )
    );
}

component MUX : [sel, a, b] -> [out] {
    wire a, b, out of bit(16);
    wire sel       of bit(1);

    out <> OR <> [
        AND <> [a, CAST <> sel],
        AND <> [b, CAST <> NOT <> sel]
    ];
}
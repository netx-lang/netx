component SMUL : [a, b] -> [y] {
    wire a, b, y of bit(16);
    y <> ADD <> [
        SHL <> [
            MUX <> [b[i], a, 32'd0], i
        ] | i in [0..32]
    ];
}

component MUX : [sel, a, b] -> [out] {
    wire a, b, out of bit(16);
    wire sel       of bit(1);

    out <> OR <> [
        AND <> [a, CAST <> sel],
        AND <> [b, NOT <> CAST <> sel]
    ];
}
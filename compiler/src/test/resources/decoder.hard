module top : [] -> [] {
    inst input : wire(bit(3))
    inst output : wire(bit(8))
    decoder(3) : [input] -> [output]
}

module decoder(width) : [code] -> [output] {
    inst code : wire(bit(width))
    inst output : wire(bit(2**width))

    for (i in [0..2**width]) {
        [port | j in [0..width],
                let port = if i & (1 << j) then TO else NOT
        ] <> AND(width) : [code[j] | j in [0..width]] -> [output[i]]
    }
}
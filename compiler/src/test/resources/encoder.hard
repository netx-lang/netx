component top : [input] -> [output] {
    inst input of wire(bit(8))
    inst output of wire(bit(3))
    [input] -> encoder(3) -> [output]
}

component encoder(width) : [code] -> [output] {
    inst code of wire(bit(2**width))
    inst output of wire(bit(width))

    for (i in [0..width]) {
        [input[j] |
            j in [0..2**width],
            when j & (1 << i)
        ] -> OR(width + 1) -> output[i]
    }
}
component riscv : [
    clk, rst, imemDataOut, dmemDataOut
] -> [
    imemAddr, 
    dmemAddr, dmemDataIn, dmemOp, dmemWe
] {
    inst clk of clock()
    inst rst of wire(bit(1))
    inst imemDataOut of wire(bit(32))
    inst dmemDataOut of wire(bit(32))

    inst instr, PC, nextPC of wire(auto)
    inst func7, rs2, rs1, func3, rd, op of wire(auto)
    inst imm, Ra, Rb, result, zero, less, PCAsrc, PCBsrc of wire(auto)
    inst imemAddr, dmemAddr, dmemDataIn of wire(auto)
    inst extOP, regWr, branch_ctl, memToReg, dmemWe, dmemOp, aSrc, bSrc, ctl of wire(auto)

    [imemDataOut] -> TO -> [instr]
    instr[31:25]  -> TO -> [func7]
    instr[24:20]  -> TO -> [rs2]
    instr[19:15]  -> TO -> [rs1]
    instr[14:12]  -> TO -> [func3]
    instr[11:7]   -> TO -> [rd]
    instr[6:0]    -> TO -> [op]

    [op, func3, func7[5]] -> InstrDecoder  -> [extOP, regWr, branch_ctl, memToReg, dmemWe, dmemOp, aSrc, bSrc, ctl]
    [extOP, instr] -> ImmSelector  -> [imm]

    [] -> [clk, rs1, rs2, rd, [imm, dmemDataOut, memToReg] <> MUX(1)] <> RegFile -> [Ra, Rb]

    [] -> [
        [Ra, PC, aSrc] <> MUX(1),
        [Rb, imm, 4, 4, bSrc] <> MUX(2), ctl
    ] <> ALU -> [result, zero, less]

     [branch_ctl, zero, less] -> BranchCond -> [PCAsrc, PCBsrc]

    [] -> [
        [4, imm, PCAsrc]<> MUX(1),
        [PC, Ra, PCBsrc]<> MUX(1)
    ] <> ADD -> [nextPC]

    [] -> [nextPC, 32'b0, rst] <> MUX(1) <> REGISTER(clk, false, PC) -> [PC]

    [nextPC, 32'b0, rst] -> MUX(1) -> [imemAddr]
    [result] -> TO -> [dmemAddr]
    [Rb]     -> TO -> [dmemDataIn]
}

component InstrDecoder : [op_i, func3, func7] -> [extOP, regWr, branch_ctl, memToReg, memWr, memOP, aSrc, bSrc, ctl] {
    inst op_i  of wire(bit(7))
    inst func3 of wire(bit(3))
    inst func7 of wire(bit(1))
    inst extOP, regWr, branch_ctl, memToReg, memWr, memOP, aSrc, bSrc, ctl of wire(auto)
    inst U_flag_0, U_flag_1, I_flag_0, R_flag, J_flag, I_flag_1, B_flag, I_flag_2, S_flag, U_flag, I_flag of wire(auto)
    inst op of wire(bit(5))
    [op_i[6:2]] -> TO -> [op]
    [op, 5'b01101] -> EQ -> [U_flag_0] // lui
    [op, 5'b00101] -> EQ -> [U_flag_1] // auipc
    [op, 5'b00100] -> EQ -> [I_flag_0] // addi, slti, sltiu, xori, ori, andi, slli, srli, srai
    [op, 5'b01100] -> EQ -> [R_flag]   // add, sub, sll, slt, sltu, xor, srl, sra, or, and
    [op, 5'b11011] -> EQ -> [J_flag]   // jal
    [op, 5'b11001] -> EQ -> [I_flag_1] // jalr
    [op, 5'b11000] -> EQ -> [B_flag]   // beq, bne, blt, bge, bltu, bgeu
    [op, 5'b00000] -> EQ -> [I_flag_2] // lb, lh, lw, lbu, lhu
    [op, 5'b01000] -> EQ -> [S_flag]   // sb, sh, sw

    [U_flag_0, U_flag_1] -> OR -> [U_flag]
    [I_flag_0, I_flag_1, I_flag_2] -> OR(3) -> [I_flag]

    let branch = component cond, pred : [1'b0 <> EXT, pred, cond] <> MUX(1)
    [] -> [
        branch(U_flag, 3'b001),
        branch(I_flag, 3'b000),
        branch(J_flag, 3'b100),
        branch(B_flag, 3'b011),
        branch(S_flag, 3'b010)
    ] <> AND(5) -> [extOP]
    
    [] -> [U_flag, I_flag, R_flag, J_flag] <> OR(4) -> [regWr]

    [] -> [
        branch(J_flag,   3'b001),
        branch(I_flag_1, 3'b010),
        branch(B_flag, [
                branch([func3, 3'b000] <> EQ, 3'b100), // beq
                branch([func3, 3'b001] <> EQ, 3'b101), // bne
                branch([func3, 3'b100] <> EQ, 3'b110), // blt
                branch([func3, 3'b101] <> EQ, 3'b111), // bge
                branch([func3, 3'b110] <> EQ, 3'b110), // bltu
                branch([func3, 3'b111] <> EQ, 3'b111)  // bgeu
            ] <> AND(6)
        )
    ] <> AND(3) -> [branch_ctl]

    [] -> I_flag_2 -> [memToReg]

    [] -> S_flag -> [memWr]

    [] -> branch([I_flag_2, S_flag] <> OR, func3) -> [memOP]

    [] -> [U_flag_1, J_flag, I_flag_1] <> OR(3) -> [aSrc]

    [] -> [
        branch([U_flag_0, U_flag_1, I_flag_0, I_flag_2, S_flag] <> OR(5), 2'b01),
        branch([J_flag, I_flag_1] <> OR, 2'b10),
        branch([R_flag, B_flag] <> OR, 2'b00)
    ] <> AND(3) -> [bSrc]

    inst de_func3 of wire(bit(8))
    inst arith_ctl of wire(bit(4))
    [func3] -> DECODER(3) -> [de_func3]
    [] -> [
        branch(de_func3[3'b000], [func7, 3'b000] <> CONCAT),
        branch(de_func3[3'b001], 4'b0001),
        branch(de_func3[3'b010], 4'b0010),
        branch(de_func3[3'b011], 4'b1010),
        branch(de_func3[3'b100], 4'b0100),
        branch(de_func3[3'b101], [func7, 3'b101] <> CONCAT),
        branch(de_func3[3'b110], 4'b0110),
        branch(de_func3[3'b111], 4'b0111)
    ] <> AND(8) -> [arith_ctl]

    [] -> [
        branch(U_flag_0, 4'b0011),
        branch([I_flag_0, R_flag] <> OR, arith_ctl),
        branch(B_flag, [4'b0010, 4'b1010, [func3[3], func3[2]] <> AND] <> MUX(1)),
        branch([U_flag_1, J_flag, I_flag_1, I_flag_2, S_flag] <> OR(5), 4'b0000)
    ] <> AND(4) -> [ctl]
}

component ImmSelector: [extOP, instr] -> [imm] {
    inst extOP of wire(bit(3))
    inst instr of wire(bit(32))
    inst imm   of wire(bit(32))

    let immI = [instr[31] <> EXT(20), instr[31:20]] <> CONCAT
    let immU = [instr[31:12], 12'b0] <> CONCAT
    let immS = [instr[31] <> EXT(20), instr[31:25], instr[11:7]] <> CONCAT(3)
    let immB = [instr[31] <> EXT(20), instr[7], instr[30:25], instr[11:8], 1'b0] <> CONCAT(5)
    let immJ = [instr[31] <> EXT(12), instr[19:12], instr[20], instr[30:21], 1'b0] <> CONCAT(5)

    inst mask of wire(bit(8))
    [extOP] -> DECODER(3) -> [mask]
    let branch = component i, pred: [1'b0 <> EXT, pred, mask[i]] <> MUX(1)
    [] -> [
        branch(3'b000, immI), branch(3'b001, immU), 
        branch(3'b010, immS), branch(3'b011, immB), branch(3'b100, immJ)
    ] <> AND(5) -> [imm]
}

component ALU: [a, b, ctl] -> [result, zero, less] {
    inst a, b       of wire(bit(32))
    inst ctl        of wire(bit(4))
    inst zero, less of wire(bit(1))
    inst result     of wire(bit(32))

    inst mask       of wire(bit(8))
    [ctl[2:0]] -> DECODER(3) -> [mask]
    let firBranch = component i, pred: [1'b0 <> EXT, pred, mask[i]] <> MUX(1)
    let secBranch = component i, b0, b1: firBranch(i, [b0, b1, ctl[3]] <> MUX(1))
    [] -> [
        secBranch(3'b000, [a, b] <> ADD, [a, b] <> SUB),
        firBranch(3'b001, [a, b[4:0]] <> SHL),
        secBranch(3'b010, [a, b] <> SLT, [a, b] <> ULT) <> EXT,
        firBranch(3'b011, b),
        firBranch(3'b100, [a, b] <> XOR),
        secBranch(3'b101, [a, b[4:0]] <> LSHR, [a, b[4:0]] <> ASHR),
        firBranch(3'b110, [a, b] <> OR),
        firBranch(3'b111, [a, b] <> AND)
    ] <> AND(8) -> [result]

    [] -> [result[i] | i in [0..32]] <> OR(32) <> NOT -> [zero]
    [result[0]] -> TO -> less
}

component BranchCond : [branch_ctl, zero, less] -> [PCAsrc, PCBsrc] {
    inst branch_ctl     of wire(bit(3))
    inst zero, less     of wire(bit(1))
    inst PCAsrc, PCBsrc of wire(bit(1))

    inst result of wire(bit(2))
    inst mask   of wire(bit(8))
    [branch_ctl] -> DECODER(3) -> [mask]
    let branch = component i, pred: [1'b0 <> EXT, pred, mask[i]] <> MUX(1)
    [] -> [
        branch(3'b000, 2'b00),
        branch(3'b001, 2'b10),
        branch(3'b010, 2'b11),
        branch(3'b100, [zero, 1'b0] <> CONCAT),
        branch(3'b101, [zero <> NOT, 1'b0] <> CONCAT),
        branch(3'b110, [less, 1'b0] <> CONCAT),
        branch(3'b111, [less <> NOT, 1'b0] <> CONCAT)
    ] <> AND(7) -> [result]
    [result[1]] -> TO -> PCAsrc
    [result[0]] -> TO -> PCBsrc
}


component RegFile : [clk, RaAddr, RbAddr, WrAddr, WrValue] -> [Ra, Rb] {
    inst clk                    of clock()
    inst RaAddr, RbAddr, WrAddr of wire(bit(5))
    inst Ra, Rb, WrValue        of wire(bit(32))

    for (i in [0..32]) {
        inst regFile_${i} of wire(bit(32))
    }

    inst mask of wire(bit(32))
    [WrAddr] -> DECODER(5) -> [mask]
    [] -> [
        [regFile_${i}, WrValue, mask[i]] <> MUX(1) <>
        REGISTER(clk, true, regFile_${i}) <> IGNORE
        | i in [0..32]
    ] -> []

    let INDEX_ACCESS = [regFile_${i} | i in [0..32]] :: [TO] <> MUX(5)
    
    [RaAddr] -> INDEX_ACCESS -> [Ra]
    [RbAddr] -> INDEX_ACCESS -> [Rb]
}

component MUX(width) : [input_${i} | i in [0..W]] :: [code] -> [output] {
    let W = 2**width
    inst code of wire(bit(width))
    inst mask of wire(bit(W))
    inst output of wire(auto)
    for (i in [0..W]) {
        inst input_${i} of wire(auto)
    }
    [code] -> DECODER(width) -> [mask]
    
    [mask[i] | i in [0..W]] -> [
        [input_${i}, EXT] <> AND | i in [0..W]
    ] <> AND(W) -> [output]
}

component DECODER(width) : [code] -> [output] {
    let W = 2**width
    inst code   of wire(bit(width))
    inst output of wire(bit(W))
    for (i in [0..W]) {
        [code[j] | j in [0..width]] -> [port | j in [0..width],
                let port = if i & (1 << j) then TO else NOT
        ] <> AND(width) -> [output[i]]
    }
}

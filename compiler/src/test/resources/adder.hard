module full_adder: [a, b, cin] -> [out, cout] {
    component a, b, cin, out, cout : wire(bit(1))
    [half_adder, TO] <> [TO, half_adder] <> [OR, TO] : [a, b, cin] -> [cout, out]
}

module half_adder: [a, b] -> [carry, out] {
    component a, b, out, carry : wire(bit(1))
    XOR : [a, b] -> [out]
    AND : [a, b] -> [carry]
}
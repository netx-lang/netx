component top: [clk_50] -> [hex] {
	wire clk_50 of clock();
	wire hex[8] of bit(7);

	let REG(clk) = REGISTER(true) <> [clk#, TO];

	wire ms_clk, s_clk, m_clk, h_clk of clock();
	wire ms of bit(32);

	ms_clk <> clock_divider(500000) <> clk_50;
	ms <> REG(ms_clk) <> MUX(1) <> [EQ <> [ms, 24 * 3600 * 100 - 1], ADD <> [ms, 1], 0];

	hex[0] <> hex_trigger <> CAST <> MOD <> [ms, 10];
	hex[1] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 100], 10];
	hex[2] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 1000], 100];
	hex[3] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 6000], 1000];
	hex[4] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 60000], 6000];
	hex[5] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 360000], 60000];
	hex[6] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 3600000], 360000];
	hex[7] <> hex_trigger <> CAST <> DIV <> [MOD <> [ms, 86400000], 3600000];
}

component clock_divider(max): [clk_50] -> [clk] {
	wire clk_50, clk of clock();
	wire count       of bit(32);

	let REG = REGISTER(true) <> [clk_50#, TO];
	let ctl = EQ <> [count, max / 2 - 1];
	count <> REG <> MUX(1) <> [ctl, ADD <> [count, 1], 0];
	clk   <> AS_CLK <> REG <> MUX(1) <> [ctl, AS_BIT <> clk, NOT <> AS_BIT <> clk];
}

component hex_trigger: [num] -> [code] {
	wire num  of bit(4);
	wire code of bit(7);
	code <> MUX(4) <> [
	    num,
		7'b1000000, // 0
		7'b1111001, // 1
		7'b0100100, // 2
		7'b0110000, // 3
		7'b0011001, // 4
		7'b0010010, // 5
		7'b0000010, // 6
		7'b1111000, // 7
		7'b0000000, // 8
		7'b0010000, // 9
		7'b0001000, // A
		7'b0000011, // b
		7'b1000110, // C
		7'b0100001, // d
		7'b0000110, // E
		7'b0001110  // F
	];
}

component MUX(width) : [code] ++ [input[i] | i in [0..W]] -> [out] {
    let W = 2**width;
    wire code of bit(width);
    wire mask of bit(W);
    auto input[W], out;
    mask <> DECODER(width) <> code;
    out <> OR(W) <> [
        AND <> [input[i], CAST <> mask[i]] | i in [0..W]
    ];
}

component DECODER(width) : [code] -> [out] {
    let W = 2**width;
    wire code of bit(width);
    wire out  of bit(W);
    for i in [0..W] {
        out[i] <> AND(width) <> [port |
            j in [0..width],
            let port = if i & (1 << j) then TO else NOT
        ] <> [code[j] | j in [0..width]];
    }
}

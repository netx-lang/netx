interface Package: [valid, load] {
    wire valid of bit(1);
    wire load  of bit(32);
}

component top: [pin] -> [pout] {
    bundle pin[4] of Package;
    bundle pout of Package;
    pout <+> Package <> [
        AND(4) <> [pin[i].valid | i in [0..4]],
        ADD(4) <> [pin[i].load  | i in [0..4]]
    ];
}

component Checker: [admin, pin] -> [pout] {
    wire admin of bit(1);
    bundle pin, pout of Package;
    pout.valid <> AND <> [admin, pin.valid];
    pout.load  <> pin.load;
}
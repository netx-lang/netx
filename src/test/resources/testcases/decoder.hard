component top : [input] -> [output] {
    inst input of wire(bit(3))
    inst output of wire(bit(8))
    #output <> decoder(3) <> input
}

component decoder(width) : [code] -> [output] {
    inst code of wire(bit(width))
    inst output of wire(bit(2**width))

    for (i in [0..2**width]) {
        #output[i] <> AND(width) <> [port |
            j in [0..width],
            let port = if i & (1 << j) then TO else NOT
        ] <> [code[j] | j in [0..width]]
    }
}
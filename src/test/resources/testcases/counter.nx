component counter : [clk, rst] -> [count] {
    wire count of bit(32);
    wire rst of bit(1);
    wire clk of clock();
    let REG = REGISTER(true) <> [TO, clk#];
    count <> REG <> MUX <> [rst, ADD <> [count, 1], 0];
}

component MUX : [ctl, i0, i1] -> [output] {
    auto ctl, i0, i1, output;
    output <> OR <> [
        AND <> [i0, CAST <> NOT <> ctl],
        AND <> [i1, CAST <> ctl]
    ];
}

component top: [x] -> [arr, brr] {
    wire x of bit(32)
    wire arr of array(bit(32), 8)
    wire brr of array(array(bit(32), 8), 4)
    for (i in [0..8]) {
        arr[i] <> ADD <> [x, i]
    }
    for (i in [0..4]) {
        for (j in [0..8]) {
            brr[i][j] <> ADD <> [x, i * 8 + j]
        }
    }
}
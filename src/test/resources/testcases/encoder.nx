component top : [input] -> [output] {
    wire input of bit(8);
    wire output of bit(3);
    output <> encoder(3) <> input;
}

component encoder(width) : [code] -> [output] {
    wire code of bit(2**width);
    wire output of bit(width);

    for i in [0..width] {
        output[i] <> OR(width + 1) <> [code[j] |
            j in [0..2**width],
            when j & (1 << i)
        ];
    }
}
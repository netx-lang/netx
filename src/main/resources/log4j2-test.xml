<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="consolePattern">
            %d{HH:mm:ss} %highlight{%-5level}{ERROR=red} %c{1} - %msg%n
        </Property>
        <Property name="filePattern">
            %d{HH:mm:ss} %-5level %c{1.} %t - %msg%n
        </Property>
    </Properties>
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <!-- stdout accepts info, debug, and trace messages. -->
            <LevelRangeFilter minLevel="INFO" maxLevel="ALL"/>
            <PatternLayout pattern="${consolePattern}" disableAnsi="false"/>
        </Console>
        <Console name="stderr" target="SYSTEM_ERR" >
            <!-- stderr accepts warn and error messages. -->
            <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${consolePattern}" disableAnsi="false"/>
        </Console>
        <File name="logFile" fileName="build/outputs/hardscript.log" append="false">
            <PatternLayout pattern="${filePattern}"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="pascal.hardscript" level="debug" additivity="false">
            <AppenderRef ref="stdout">
                <!-- Filter messages to keep the console clean. Turn the level
                 to "DEBUG" when debugging or simply refer to the log file. -->
                <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
            </AppenderRef>
            <AppenderRef ref="stderr"/>
            <AppenderRef ref="logFile"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="stdout"/>
            <AppenderRef ref="stderr"/>
        </Root>
    </Loggers>
</Configuration>